{
  "name": "nebsam-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-migrations.mjs && next build && node scripts/check-retired-strings.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:strings": "node scripts/check-retired-strings.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "verify:db": "node scripts/verify-db.mjs",
    "db:types": "supabase gen types typescript --linked > types/database.ts",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "next": "^15.5.23",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
