# ============================================================================
# NEBSAM WEBSITE — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in. NEVER commit .env.local.
# Every new variable must be added here in the same commit that introduces its use.
# ============================================================================

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://nebsamdigital.com   # no trailing slash; used for canonicals + sitemap
NEXT_PUBLIC_SITE_ENV=development                 # development | preview | production

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=                        # project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=                   # public anon key; read-only via RLS
SUPABASE_SERVICE_ROLE_KEY=                       # SERVER ONLY. Never expose to the client.
SUPABASE_ACCESS_TOKEN=                           # Personal access token, supabase.com/dashboard/account/tokens.
                                                 # LOCAL DEV ONLY: needed by `npm run db:types`, never at runtime.

# --- Conversion -------------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=254759000111         # all shop orders route here (brief PART 1.5 #12)
NEXT_PUBLIC_PHONE_PRIMARY=+254759000111

# --- Certificate verification (brief PART 9.2 — security critical) ----------
CERT_PLATE_HMAC_SECRET=                          # SERVER ONLY. Keys the plate hash. Rotating it
                                                 # invalidates the lookup index — plan migrations.
CERT_VERIFY_RATE_LIMIT_PER_HOUR=10               # per IP
CERT_VERIFY_RATE_LIMIT_PER_PLATE_PER_DAY=5
CERT_QR_TOKEN_SECRET=                            # SERVER ONLY. Signs printed-certificate QR links.

# --- Bot protection ---------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=                            # SERVER ONLY

# --- Email ------------------------------------------------------------------
EMAIL_PROVIDER_API_KEY=                          # SERVER ONLY (Resend or equivalent)
EMAIL_FROM=no-reply@nebsamdigital.com
EMAIL_SALES_INBOX=onlinesales@nebsamdigital.com
EMAIL_INFO_INBOX=info@nebsamdigital.com

# --- Analytics --------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=                  # must not fire before cookie consent

# --- Commerce ---------------------------------------------------------------
NEXT_PUBLIC_VAT_RATE=0.16                        # prices stored EXCL. VAT (brief PART 1.5 #10)
                                                 # verify the current rate before launch

# --- Media (optional) -------------------------------------------------------
CLOUDINARY_URL=                                  # SERVER ONLY, if used
